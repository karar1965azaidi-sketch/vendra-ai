<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#090b12"><title>VENDRA AI — Store Builder</title>
<style>
:root{color-scheme:dark;--bg:#090b12;--panel:#141a29;--line:#2a3348;--muted:#a0aac0;--purple:#8b5cf6;--white:#f7f7fc}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--white);font:15px -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.app{max-width:1100px;margin:auto;padding:18px}.top{display:flex;justify-content:space-between;align-items:center;padding:10px 0 22px;border-bottom:1px solid var(--line)}.logo{font-weight:900;letter-spacing:3px;font-size:20px}.logo span{color:#ad91ff}.tag{font-size:11px;color:#c7b6ff;border:1px solid #55417e;padding:6px 9px;border-radius:20px}.layout{display:grid;grid-template-columns:210px 1fr;gap:22px;padding-top:22px}.nav{display:grid;gap:8px;align-content:start}.nav button,.btn{border:1px solid var(--line);background:#171d2c;color:var(--white);border-radius:11px;padding:13px;text-align:left;font-weight:650;cursor:pointer}.nav button.active,.btn.primary{background:linear-gradient(120deg,#8b5cf6,#6842cf);border-color:transparent}.content{min-width:0}.page{display:none}.page.active{display:block}.eyebrow{color:#b8a3ff;text-transform:uppercase;font-size:11px;letter-spacing:2px;font-weight:800}.h1{font-size:clamp(28px,5vw,40px);margin:8px 0}.muted{color:var(--muted);line-height:1.5}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:22px 0}.card{background:var(--panel);border:1px solid var(--line);border-radius:15px;padding:17px}.number{font-size:28px;font-weight:800;margin-top:8px}.field{display:grid;gap:7px;margin:14px 0}.field label{font-size:13px;color:#cbd1e0}.field input,.field select,.field textarea{width:100%;padding:13px;border:1px solid #3a4560;background:#0c111d;color:white;border-radius:10px;font:inherit}.btn{display:inline-block;text-align:center;margin:6px 6px 6px 0}.result{margin-top:18px}.store{display:flex;justify-content:space-between;gap:10px;align-items:center;border-top:1px solid var(--line);padding:14px 0}.pill{font-size:11px;color:#8ce2c8;border:1px solid #286b5e;border-radius:20px;padding:5px 8px}.product{background:#0d1320;border:1px solid var(--line);border-radius:10px;padding:13px;margin:8px 0}.empty{border:1px dashed #46516b;padding:25px;border-radius:12px;color:var(--muted);text-align:center;margin-top:14px}.notice{font-size:12px;color:#aeb8cc;margin-top:14px}.toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:#28213d;border:1px solid #7054a8;border-radius:12px;padding:12px 16px;max-width:90%;display:none;z-index:4}.preview{background:linear-gradient(145deg,#211a37,#101725);padding:24px;border-radius:14px;text-align:center;margin-top:14px}.preview h2{font-size:30px;margin:10px}.previewitems{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:18px;text-align:left}.previewitems div{background:#111827;border:1px solid #343b52;border-radius:9px;padding:12px;font-size:13px}
@media(max-width:700px){.app{padding:14px}.layout{grid-template-columns:1fr;gap:14px}.nav{grid-template-columns:repeat(2,minmax(0,1fr))}.nav button{font-size:13px;padding:11px}.cards{grid-template-columns:1fr 1fr}.previewitems{grid-template-columns:1fr}.top{padding-bottom:15px}}
</style></head><body><div class="app"><header class="top"><div class="logo"><span>✦</span> VENDRA AI</div><div class="tag">INDEPENDENT STORE BUILDER · DEMO</div></header><div class="layout"><nav class="nav" aria-label="Main navigation"><button class="active" data-page="home">Overview</button><button data-page="builder">AI Store Builder</button><button data-page="stores">My Stores</button><button data-page="products">Products</button><button data-page="brand">Brand Studio</button><button data-page="settings">Settings</button></nav><main class="content">
<section class="page active" id="home"><div class="eyebrow">YOUR WORKSPACE</div><h1 class="h1">Build your next store.</h1><p class="muted">Create a store concept, manage products and shape your brand in one place.</p><div class="cards"><div class="card">Stores<div class="number" id="countStores">0</div></div><div class="card">Products<div class="number" id="countProducts">0</div></div><div class="card">AI concepts<div class="number" id="countAI">0</div></div></div><button class="btn primary" data-go="builder">＋ Create a store</button><div class="card" style="margin-top:16px"><b>Getting started</b><p class="muted">1. Describe what you want to sell. 2. Generate a store concept. 3. Save it and add products.</p></div></section>
<section class="page" id="builder"><div class="eyebrow">AI STORE BUILDER</div><h1 class="h1">What are you selling?</h1><p class="muted">Enter an idea and create a storefront concept. This demo runs locally in your browser.</p><div class="card"><div class="field"><label for="idea">Product or business idea</label><input id="idea" placeholder="For example: premium skincare"></div><div class="field"><label for="storeName">Store name (optional)</label><input id="storeName" placeholder="For example: AUREL Studio"></div><div class="field"><label for="style">Brand style</label><select id="style"><option>Premium minimal</option><option>Bold and energetic</option><option>Modern and clean</option><option>Playful and colorful</option></select></div><button class="btn primary" id="generate">✦ Generate store concept</button><div class="notice">Note: this is a local demo generator, not connected to a live AI service yet.</div></div><div id="generated" class="result" hidden><div class="eyebrow">YOUR STORE PREVIEW</div><div class="preview"><div class="eyebrow">WELCOME TO</div><h2 id="previewName"></h2><p id="previewTag" class="muted"></p><div class="previewitems" id="previewItems"></div></div><button class="btn primary" id="saveStore">Save this store</button></div></section>
<section class="page" id="stores"><div class="eyebrow">WORKSPACE</div><h1 class="h1">My Stores</h1><p class="muted">Your saved store concepts.</p><div class="card" id="storeList"></div></section>
<section class="page" id="products"><div class="eyebrow">CATALOG</div><h1 class="h1">Products</h1><p class="muted">Add products to your demo catalog.</p><button class="btn primary" id="addProduct">＋ Add product</button><div class="card" id="productList" style="margin-top:14px"></div></section>
<section class="page" id="brand"><div class="eyebrow">IDENTITY</div><h1 class="h1">Brand Studio</h1><div class="card"><div class="field"><label for="brandName">Brand name</label><input id="brandName" placeholder="Your brand"></div><div class="field"><label for="brandTag">Tagline</label><input id="brandTag" placeholder="Your brand promise"></div><button class="btn primary" id="saveBrand">Save brand identity</button><p class="muted" id="brandSaved"></p></div></section>
<section class="page" id="settings"><div class="eyebrow">PREFERENCES</div><h1 class="h1">Settings</h1><div class="card"><p class="muted">VENDRA AI demo · English interface · Dark theme.</p><button class="btn" id="reset">Reset demo data</button><p class="notice">Reset deletes the stores and products saved in this browser.</p></div></section>
</main></div></div><div class="toast" id="toast" role="status"></div>
<script>
(()=>{'use strict';
const $=id=>document.getElementById(id);let data={stores:[],products:[],ai:0,pending:null};
try{const saved=localStorage.getItem('vendra_demo_v2');if(saved)data={...data,...JSON.parse(saved)}}catch(e){}
function persist(){try{localStorage.setItem('vendra_demo_v2',JSON.stringify(data))}catch(e){toast('Browser storage is unavailable; data may not persist after closing.')}}
function toast(msg){const el=$('toast');el.textContent=msg;el.style.display='block';clearTimeout(toast.timer);toast.timer=setTimeout(()=>el.style.display='none',2600)}
function escapeHTML(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function show(page){document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.id===page));document.querySelectorAll('[data-page]').forEach(b=>b.classList.toggle('active',b.dataset.page===page));window.scrollTo(0,0);if(page==='stores')renderStores();if(page==='products')renderProducts()}
document.querySelectorAll('[data-page]').forEach(b=>b.addEventListener('click',()=>show(b.dataset.page)));document.querySelectorAll('[data-go]').forEach(b=>b.addEventListener('click',()=>show(b.dataset.go)));
function render(){ $('countStores').textContent=data.stores.length;$('countProducts').textContent=data.products.length;$('countAI').textContent=data.ai;renderStores();renderProducts() }
function renderStores(){const el=$('storeList');el.innerHTML=data.stores.length?data.stores.map((s,i)=>`<div class="store"><div><b>${escapeHTML(s.name)}</b><div class="muted">${escapeHTML(s.idea)} · ${escapeHTML(s.style)}</div></div><span class="pill">Concept</span></div>`).join(''):'<div class="empty">No stores yet. Open AI Store Builder to create one.</div>'}
function renderProducts(){const el=$('productList');el.innerHTML=data.products.length?data.products.map((p,i)=>`<div class="product"><b>${escapeHTML(p.name)}</b><div class="muted">${p.price?escapeHTML(p.price):'Price not set'}</div><button class="btn" data-delete-product="${i}">Delete</button></div>`).join(''):'<div class="empty">No products yet. Tap Add product to begin.</div>';el.querySelectorAll('[data-delete-product]').forEach(b=>b.addEventListener('click',()=>{data.products.splice(Number(b.dataset.deleteProduct),1);persist();render();toast('Product deleted.')}))}
$('generate').addEventListener('click',()=>{const idea=$('idea').value.trim();if(!idea){toast('Please enter what you want to sell.');$('idea').focus();return}const name=$('storeName').value.trim()||idea.split(/[,&]/)[0].replace(/\b\w/g,c=>c.toUpperCase())+' Studio';const style=$('style').value;data.pending={name,idea,style,tag:style==='Bold and energetic'?'Make your mark. Move with purpose.':'Thoughtfully selected. Made for your everyday.'};$('previewName').textContent=name.toUpperCase();$('previewTag').textContent=data.pending.tag;const samples=idea.toLowerCase().includes('skin')?['Daily Renewal Serum','Hydration Cream','Glow Essentials']:idea.toLowerCase().includes('home')?['Sculptural Vase','Soft Knit Throw','Ceramic Table Light']:['Signature Essential','Everyday Edit','Studio Favourite'];$('previewItems').innerHTML=samples.map((x,i)=>`<div>✦<br><b>${x}</b><br><span class="muted">Product concept</span></div>`).join('');$('generated').hidden=false;data.ai++;persist();render();toast('Your store concept is ready.')});
$('saveStore').addEventListener('click',()=>{if(!data.pending){toast('Generate a store first.');return}data.stores.unshift({...data.pending});data.pending=null;persist();render();show('stores');toast('Store saved on this device.')});
$('addProduct').addEventListener('click',()=>{const name=prompt('Enter product name:');if(!name||!name.trim())return;const price=prompt('Enter price (optional):','');data.products.push({name:name.trim(),price:(price||'').trim()});persist();render();toast('Product added.')});
$('saveBrand').addEventListener('click',()=>{const name=$('brandName').value.trim();if(!name){toast('Enter a brand name first.');$('brandName').focus();return}try{localStorage.setItem('vendra_brand_v2',JSON.stringify({name,tag:$('brandTag').value.trim()}))}catch(e){}$('brandSaved').textContent='Brand identity saved on this device.';toast('Brand identity saved.')});
$('reset').addEventListener('click',()=>{if(!confirm('Delete all VENDRA demo stores and products from this browser?'))return;data={stores:[],products:[],ai:0,pending:null};persist();render();toast('Demo data reset.')});
render();
})();
</script></body></html>
